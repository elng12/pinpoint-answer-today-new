NEXT_PUBLIC_SITE_URL=http://localhost:3004
# Optional X/Twitter handle for twitter:site card attribution, e.g. @pinpointtoday
NEXT_PUBLIC_TWITTER_HANDLE=
NEXT_PUBLIC_ENABLE_GA=false
NEXT_PUBLIC_GA_ID=

# ISR on-demand revalidation (generate a random string, e.g. openssl rand -hex 32)
# Send it via Authorization: Bearer <secret> or x-revalidate-secret.
REVALIDATE_SECRET=

# Contact form delivery webhook
# Preferred: a dedicated JSON webhook endpoint that persists or forwards the feedback.
# Fallback: if left empty, the contact form will try FEISHU_WEBHOOK_URL,
# SLACK_WEBHOOK_URL, or ALERT_WEBHOOK_URL using their native payload format.
FEEDBACK_WEBHOOK_URL=
FEEDBACK_WEBHOOK_SECRET=

# Worker fallback webhook auth for /api/fallback/worker-pinpoint
FALLBACK_WEBHOOK_SECRET=

# Optional competitor-source fetch tuning for /api/fallback/worker-pinpoint
# PINPOINT_BASE_URL=https://pinpointanswer.today/
# COMPETITOR_FETCH_TIMEOUT_MS=30000
# PINPOINT_FETCH_UA=
# PINPOINT_FETCH_LANG=en-US,en;q=0.9

# Optional anti-abuse controls for /api/feedback
# FEEDBACK_RATE_LIMIT_MAX=5
# FEEDBACK_RATE_LIMIT_WINDOW_MS=600000

# Optional legacy notification channels used as contact-form fallback
# FEISHU_WEBHOOK_URL=
# SLACK_WEBHOOK_URL=
# ALERT_WEBHOOK_URL=

# Optional public content base URL for remote puzzle fetching in production.
# Leave blank to use bundled/deployed puzzle JSON only.
# Set this only when the target files are publicly readable.
# GITHUB_RAW_BASE=

# Optional Cloudflare Worker health URL used by:
# - /api/health proxy (Vercel -> Worker)
# - /api/pinpoint/today proxy (Vercel -> Worker)
# If left empty, the app falls back to the default production worker.
# Example: https://pinpoint-worker.2296744453m.workers.dev/health
PINPOINT_WORKER_HEALTH_URL=

# AI generation defaults
# Example with OpenRouter:
# OPENAI_API_KEY=sk-or-v1-...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=google/gemini-2.0-flash-001
